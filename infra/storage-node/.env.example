# Storage-only production profile (this machine)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_GATEWAY_PORT=8100
MINIO_DATA_DIR=/srv/orchestrator/minio-data

# MinIO internal endpoint (gateway -> minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_ME_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_ME_STRONG_SECRET_KEY
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true

# Presign delivery mode (gateway|minio). Use gateway for external clients.
PRESIGN_MODE=gateway
STORAGE_PUBLIC_BASE_URL=https://discoverex.qzz.io
STORAGE_URL_SIGNING_SECRET=REPLACE_ME_LONG_RANDOM_URL_SIGNING_SECRET

ARTIFACT_BUCKET=orchestrator-artifacts
PRESIGN_TTL_DEFAULT=900
PRESIGN_TTL_MAX=3600
STORAGE_GATEWAY_TOKEN=REPLACE_ME_LONG_RANDOM_TOKEN

# Cloudflare Access gate for external traffic
GATEWAY_REQUIRE_CF_ACCESS=false
CF_ACCESS_CLIENT_ID=-
CF_ACCESS_CLIENT_SECRET=-

# Backup policy
BACKUP_ROOT=/home/esillileu/discoverex/data/backups/minio
BACKUP_RETENTION_DAYS=30
