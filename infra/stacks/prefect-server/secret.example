# GitHub Actions CD configuration template (Prefect VM only)
# Workflow: .github/workflows/cd.yml
#
# Policy:
# - VM does not keep static .env files.
# - Action injects vars/secrets at deploy runtime via SSH session exports.

###############################################
# 1) GitHub Secrets (all required)
###############################################
# SSH access
REMOTE_HOST=
REMOTE_USERNAME=
REMOTE_SSH_KEY=

# Prefect stack sensitive values
PREFECT_DB_PASSWORD=
FLUSH_GATEWAY_TOKEN=

# Cloudflare Access tokens for flush target
FLUSH_CF_ACCESS_CLIENT_ID=
FLUSH_CF_ACCESS_CLIENT_SECRET=

###############################################
# 2) GitHub Variables
###############################################
# 2.1 Required (no default)
PREFECT_API_PUBLIC_URL=
FLUSH_TARGET_URL=

# 2.2 Optional (default exists)
# Global
IMAGE_NAMESPACE=
REMOTE_PORT=22
REMOTE_DEPLOY_PATH=/opt/services/orchestrator-prefect
ENABLE_PREFECT_DEPLOY=true

# Runtime overrides (optional):
# - Keep defaults from infra/stacks/prefect-server/.env.example unless override is needed.
# - If overriding in GitHub Variables, use the same key names as .env.example.
