# Prefect server runtime
PREFECT_PORT=4200
PREFECT_BIND_PORT=14200
PREFECT_HOSTNAME=prefect.example.com
PREFECT_API_PUBLIC_URL=https://prefect.example.com/api

# Shared Postgres (logical separation)
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect_user:REPLACE_ME@postgres-host:5432/prefect

# Cloudflare tunnel
CF_TUNNEL_ID=REPLACE_ME_TUNNEL_ID
CF_CREDENTIALS_FILE=REPLACE_ME_TUNNEL_ID.json

# Worker access token (for verification/runbooks)
CF_ACCESS_CLIENT_ID=REPLACE_ME
CF_ACCESS_CLIENT_SECRET=REPLACE_ME
