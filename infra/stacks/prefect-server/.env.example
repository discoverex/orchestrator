# Prefect server runtime
PREFECT_SERVER_IMAGE=orchestrator-prefect-server:local
PREFECT_PORT=4200
PREFECT_BIND_PORT=14200
PREFECT_BIND_ADDRESS=127.0.0.1
PREFECT_API_PUBLIC_URL=https://prefect.example.com/api

# VM-local Postgres for Prefect
PREFECT_DB_NAME=prefect
PREFECT_DB_USER=prefect_user
PREFECT_DB_PASSWORD=REPLACE_ME_PREFECT_DB_PASSWORD
PREFECT_DB_DATA_DIR=/srv/orchestrator/prefect-db

# Completed-run flush and retention
FLUSH_TARGET_URL=https://discoverex.qzz.io
FLUSH_GATEWAY_TOKEN=REPLACE_ME_STORAGE_GATEWAY_TOKEN
FLUSH_CF_ACCESS_CLIENT_ID=
FLUSH_CF_ACCESS_CLIENT_SECRET=
PREFECT_MAINT_DATA_DIR=/srv/orchestrator/prefect-maint
FLUSH_INTERVAL_SEC=600
PRUNE_INTERVAL_SEC=43200
PRUNE_TTL_HOURS=72
FLUSH_PAGE_SIZE=100
FLUSH_MAX_RUNS=500
PRUNE_PAGE_SIZE=200
PRUNE_MAX_RUNS=1000
