# Prefect API endpoint reachable from this host/container
PREFECT_API_URL=https://prefect-api.discoverex.qzz.io/api

# Deployment registration target
PREFECT_WORK_POOL=gpu-pool
# Used only when REGISTER_DEPLOYMENT_MODE=single.
PREFECT_WORK_QUEUE=gpu-fixed

# dual (default) or single
REGISTER_DEPLOYMENT_MODE=dual

# single mode
REGISTER_DEPLOYMENT_NAME=engine-run

# dual mode
REGISTER_FIXED_DEPLOYMENT_NAME=engine-run
REGISTER_FIXED_DEPLOYMENT_QUEUE=gpu-fixed
REGISTER_COLAB_DEPLOYMENT_NAME=engine-run-colab
REGISTER_COLAB_DEPLOYMENT_QUEUE=gpu-colab

# Optional
REGISTER_DEPLOYMENT_VERSION=
