# Prefect worker target
PREFECT_API_URL=https://prefect-api.discoverex.qzz.io/api
PREFECT_WORK_POOL=gpu-pool
PREFECT_WORK_QUEUE=gpu-fixed

# Optional when Prefect is behind Cloudflare Access.
# Either use the Prefect-specific names:
PREFECT_CF_ACCESS_CLIENT_ID=
PREFECT_CF_ACCESS_CLIENT_SECRET=
# Or the generic aliases currently used in the root .env:
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional raw JSON headers for Prefect client requests.
# These are merged with Cloudflare Access headers automatically.
# PREFECT_CLIENT_CUSTOM_HEADERS={"X-Test":"1"}

# Optional override for clients that reject the default browser-like value.
PREFECT_BROWSER_USER_AGENT=

# Preferred artifact path: worker -> worker-router -> storage-gateway
WORKER_ROUTER_URL=https://discoverex.qzz.io
WORKER_ROUTER_TOKEN=replace_me_worker_router_token

# Legacy direct storage access values remain as fallback only.
# Keep these available until all workers have a router token.
STORAGE_GATEWAY_URL=
STORAGE_GATEWAY_TOKEN=

# Host path mounted into /var/lib/orchestrator/checkpoints in the container.
WORKER_CHECKPOINT_DIR=../../../../../runtime/worker/checkpoints
WORKER_CONTAINER_NAME=orchestrator-worker-fixed
