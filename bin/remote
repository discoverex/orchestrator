#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${ROOT_DIR}/bin/lib/remote_lib.sh"
load_remote_env "${ROOT_DIR}"

COMMAND="${1:-}"
shift || true

REMOTE_USERNAME="${REMOTE_USERNAME:-}"
REMOTE_HOST="${REMOTE_HOST:-}"
GITHUB_DEPLOY_KEY_PATH="${GITHUB_DEPLOY_KEY_PATH:-}"
REMOTE_PROJECT_PATH="${REMOTE_PROJECT_PATH:-}"
REMOTE_PREFECT_PATH="${REMOTE_PREFECT_PATH:-/opt/services/orchestrator-prefect}"

GITHUB_DEPLOY_KEY_PATH="$(normalize_deploy_key_path "${GITHUB_DEPLOY_KEY_PATH}")"
REMOTE_PROJECT_PATH="$(ensure_remote_project_path "${REMOTE_PROJECT_PATH}" "${REMOTE_USERNAME}")"

PREFECT_ENV="infra/stacks/prefect-server/.env"
PREFECT_COMPOSE="infra/stacks/prefect-server/docker-compose.yml"
REMOTE_PREFECT_ENV="${REMOTE_PREFECT_ENV:-.env}"
REMOTE_PREFECT_COMPOSE="${REMOTE_PREFECT_COMPOSE:-docker-compose.yml}"

usage() {
  cat <<'EOF'
Usage:
  remote connect
  remote postgres
  remote dump
  remote prefect-install
  remote prefect <docker-compose-args...>
  remote worker <ps|logs> [args...]

Examples:
  remote prefect up -d --build
  remote prefect down
  remote prefect ps
  remote prefect logs --tail=200 prefect-server
  remote worker ps
  remote worker logs
EOF
}

remote_prefect_compose() {
  if [[ "$#" -eq 0 ]]; then
    echo "missing prefect compose args" >&2
    usage
    exit 1
  fi
  local compose_cmd
  compose_cmd="if [[ -n \"${REMOTE_PREFECT_ENV}\" && -f \"${REMOTE_PREFECT_ENV}\" ]]; then docker compose --env-file ${REMOTE_PREFECT_ENV} -f ${REMOTE_PREFECT_COMPOSE}"
  compose_cmd+="$(join_quoted "$@")"
  compose_cmd+="; else docker compose -f ${REMOTE_PREFECT_COMPOSE}"
  compose_cmd+="$(join_quoted "$@")"
  compose_cmd+="; fi"
  remote_prefect_exec "${compose_cmd}"
}

case "${COMMAND}" in
  connect)
    require_remote_env
    exec ssh -i "${GITHUB_DEPLOY_KEY_PATH}" "${REMOTE_USERNAME}@${REMOTE_HOST}"
    ;;
  postgres)
    remote_exec "docker exec -it postgres psql -U gtrpgm -d gtrpgm"
    ;;
  dump)
    OUTPUT_FILE="dump_$(date +%Y%m%d_%H%M%S).sql"
    echo "Dumping remote database to ${OUTPUT_FILE}..."
    remote_exec "docker exec postgres pg_dump -U gtrpgm -d gtrpgm" > "${OUTPUT_FILE}"
    echo "Success: Dump saved to ${OUTPUT_FILE}"
    ;;
  prefect-install)
    remote_project_exec "scripts/ops/prefect_vm_bootstrap.sh"
    ;;
  prefect)
    remote_prefect_compose "$@"
    ;;
  worker)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      ps)
        remote_prefect_worker_ls
        ;;
      logs)
        echo "Prefect API does not expose worker process logs directly."
        echo "Showing current registered workers instead:"
        remote_prefect_worker_ls
        ;;
      *)
        echo "unknown worker command: ${sub}" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  # Backward-compatible aliases
  prefect-up)
    remote_prefect_compose up -d --build
    ;;
  prefect-down)
    remote_prefect_compose down
    ;;
  prefect-ps)
    remote_prefect_compose ps
    ;;
  prefect-logs)
    remote_prefect_compose logs --tail=120 "$@"
    ;;
  worker-ps)
    remote_prefect_worker_ls
    ;;
  worker-logs)
    echo "Prefect API does not expose worker process logs directly."
    echo "Showing current registered workers instead:"
    remote_prefect_worker_ls
    ;;
  *)
    usage
    exit 1
    ;;
esac
