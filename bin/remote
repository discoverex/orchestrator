#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -f "${ROOT_DIR}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/.env"
  set +a
fi

COMMAND="${1:-}"
shift || true

REMOTE_USERNAME="${REMOTE_USERNAME:-}"
REMOTE_HOST="${REMOTE_HOST:-}"
GITHUB_DEPLOY_KEY_PATH="${GITHUB_DEPLOY_KEY_PATH:-}"
REMOTE_PROJECT_PATH="${REMOTE_PROJECT_PATH:-}"
REMOTE_PREFECT_PATH="${REMOTE_PREFECT_PATH:-/opt/services/orchestrator-prefect}"

if [[ -n "${GITHUB_DEPLOY_KEY_PATH}" && "${GITHUB_DEPLOY_KEY_PATH}" == "~/"* ]]; then
  GITHUB_DEPLOY_KEY_PATH="${HOME}/${GITHUB_DEPLOY_KEY_PATH#~/}"
fi

if [[ -z "${REMOTE_PROJECT_PATH}" && -n "${REMOTE_USERNAME}" ]]; then
  REMOTE_PROJECT_PATH="/home/${REMOTE_USERNAME}/discoverex/orchestrator"
fi

PREFECT_ENV="infra/stacks/prefect-server/.env"
PREFECT_COMPOSE="infra/stacks/prefect-server/docker-compose.yml"

require_remote_env() {
  : "${REMOTE_USERNAME:?REMOTE_USERNAME is required}"
  : "${REMOTE_HOST:?REMOTE_HOST is required}"
  : "${GITHUB_DEPLOY_KEY_PATH:?GITHUB_DEPLOY_KEY_PATH is required}"
}

remote_exec() {
  require_remote_env
  ssh -i "${GITHUB_DEPLOY_KEY_PATH}" "${REMOTE_USERNAME}@${REMOTE_HOST}" "$@"
}

remote_project_exec() {
  local cmd="$1"
  : "${REMOTE_PROJECT_PATH:?REMOTE_PROJECT_PATH is required}"
  local qpath
  qpath="${REMOTE_PROJECT_PATH//\'/\'\\\'\'}"
  remote_exec "cd '${qpath}' && ${cmd}"
}

join_quoted() {
  local out=""
  local arg
  for arg in "$@"; do
    out+=" $(printf "%q" "${arg}")"
  done
  printf "%s" "${out}"
}

usage() {
  cat <<'EOF'
Usage:
  remote connect
  remote postgres
  remote dump
  remote prefect-install
  remote prefect <docker-compose-args...>
  remote worker <ps|logs> [args...]

Examples:
  remote prefect up -d --build
  remote prefect down
  remote prefect ps
  remote prefect logs --tail=200 prefect-server
  remote worker ps
  remote worker logs
EOF
}

remote_prefect_worker_ls() {
  remote_exec "cd '${REMOTE_PREFECT_PATH}' && if [[ -f '${PREFECT_ENV}' ]]; then set -a; source '${PREFECT_ENV}'; set +a; fi; pools=\"\${REMOTE_WORKER_POOLS:-gpu-pool,colab-gpu}\"; IFS=',' read -r -a arr <<< \"\$pools\"; for p in \"\${arr[@]}\"; do echo \"== \$p ==\"; curl -fsS -H 'Content-Type: application/json' -d '{\"limit\":100,\"offset\":0}' \"http://127.0.0.1:\${PREFECT_BIND_PORT:-14200}/api/work_pools/\$p/workers/filter\" || true; echo; echo; done"
}

case "${COMMAND}" in
  connect)
    require_remote_env
    exec ssh -i "${GITHUB_DEPLOY_KEY_PATH}" "${REMOTE_USERNAME}@${REMOTE_HOST}"
    ;;
  postgres)
    remote_exec "docker exec -it postgres psql -U gtrpgm -d gtrpgm"
    ;;
  dump)
    OUTPUT_FILE="dump_$(date +%Y%m%d_%H%M%S).sql"
    echo "Dumping remote database to ${OUTPUT_FILE}..."
    remote_exec "docker exec postgres pg_dump -U gtrpgm -d gtrpgm" > "${OUTPUT_FILE}"
    echo "Success: Dump saved to ${OUTPUT_FILE}"
    ;;
  prefect-install)
    remote_project_exec "scripts/ops/prefect_vm_bootstrap.sh"
    ;;
  prefect)
    if [[ "$#" -eq 0 ]]; then
      echo "missing prefect compose args" >&2
      usage
      exit 1
    fi
    remote_project_exec "docker compose --env-file ${PREFECT_ENV} -f ${PREFECT_COMPOSE}$(join_quoted "$@")"
    ;;
  worker)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      ps)
        remote_prefect_worker_ls
        ;;
      logs)
        echo "Prefect API does not expose worker process logs directly."
        echo "Showing current registered workers instead:"
        remote_prefect_worker_ls
        ;;
      *)
        echo "unknown worker command: ${sub}" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  # Backward-compatible aliases
  prefect-up)
    remote_project_exec "docker compose --env-file ${PREFECT_ENV} -f ${PREFECT_COMPOSE} up -d --build"
    ;;
  prefect-down)
    remote_project_exec "docker compose --env-file ${PREFECT_ENV} -f ${PREFECT_COMPOSE} down"
    ;;
  prefect-ps)
    remote_project_exec "docker compose --env-file ${PREFECT_ENV} -f ${PREFECT_COMPOSE} ps"
    ;;
  prefect-logs)
    remote_project_exec "docker compose --env-file ${PREFECT_ENV} -f ${PREFECT_COMPOSE} logs --tail=120$(join_quoted "$@")"
    ;;
  worker-ps)
    remote_prefect_worker_ls
    ;;
  worker-logs)
    echo "Prefect API does not expose worker process logs directly."
    echo "Showing current registered workers instead:"
    remote_prefect_worker_ls
    ;;
  *)
    usage
    exit 1
    ;;
esac
