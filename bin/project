#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

LOCAL_COMPOSE="${ROOT_DIR}/docker-compose.local.yml"
STORAGE_ENV="${ROOT_DIR}/infra/stacks/storage-node/.env"
STORAGE_COMPOSE="${ROOT_DIR}/infra/stacks/storage-node/docker-compose.yml"
REGISTER_ENV="${ROOT_DIR}/infra/stacks/register/.env"
REGISTER_COMPOSE="${ROOT_DIR}/infra/stacks/register/docker-compose.yml"
WORKER_FIXED_ENV="${ROOT_DIR}/infra/stacks/worker/fixed/.env"
WORKER_FIXED_COMPOSE="${ROOT_DIR}/infra/stacks/worker/fixed/docker-compose.yml"
PREFECT_ENV="${ROOT_DIR}/infra/stacks/prefect-server/.env"
PREFECT_COMPOSE="${ROOT_DIR}/infra/stacks/prefect-server/docker-compose.yml"
E2E_SCRIPT="${ROOT_DIR}/scripts/e2e/e2e_orchestrator.sh"
REMOTE_E2E_SCRIPT="${ROOT_DIR}/scripts/e2e/remote_prefect_storage_e2e.sh"
SUBMIT_ROUTER_SCRIPT="${ROOT_DIR}/scripts/ops/prefect_submit_router.py"

usage() {
  cat <<'EOF'
Usage:
  project e2e [core|mlflow|full] [--keep-on-fail] [--timeout-sec N]
  project e2e-remote --prefect-api-url URL [--work-pool NAME] [--work-queue NAME] [--prune-mode dry-run|apply] [--bootstrap-worker] [--timeout-sec N]
  project storage <up|down|ps|logs|build> [args...]
  project prefect <up|down|ps|logs|build|flush|prune> [args...]
  project local <up|down|ps|logs|build> [args...]
  project register <run|build> [args...]
  project worker fixed <up|down|ps|logs|build> [args...]
  project worker register-gpu [args...]
  project worker submit [router args...]

Examples:
  project e2e
  project e2e full --keep-on-fail
  project e2e-remote --prefect-api-url https://prefect.example.com/api --prune-mode apply
  project storage up
  project storage down
  project storage logs --tail=120
  project prefect up
  project prefect flush
  project prefect prune
  project local up
  project register run
  project worker fixed up
  project worker register-gpu
  project worker submit --repo-url https://github.com/octocat/Hello-World.git --ref master
EOF
}

run_storage() {
  docker compose --env-file "${STORAGE_ENV}" -f "${STORAGE_COMPOSE}" "$@"
}

run_local() {
  docker compose -f "${LOCAL_COMPOSE}" "$@"
}

run_register() {
  docker compose --env-file "${REGISTER_ENV}" -f "${REGISTER_COMPOSE}" "$@"
}

run_prefect() {
  docker compose --env-file "${PREFECT_ENV}" -f "${PREFECT_COMPOSE}" "$@"
}

run_worker_fixed() {
  docker compose --env-file "${WORKER_FIXED_ENV}" -f "${WORKER_FIXED_COMPOSE}" "$@"
}

cmd="${1:-help}"
shift || true

case "${cmd}" in
  help|-h|--help)
    usage
    ;;

  e2e)
    if [[ ! -x "${E2E_SCRIPT}" ]]; then
      echo "missing executable: ${E2E_SCRIPT}" >&2
      exit 1
    fi
    mode="${1:-}"
    case "${mode}" in
      core|mlflow|full)
        shift
        exec "${E2E_SCRIPT}" --mode "${mode}" "$@"
        ;;
      "")
        exec "${E2E_SCRIPT}" --mode core "$@"
        ;;
      *)
        exec "${E2E_SCRIPT}" "$mode" "$@"
        ;;
    esac
    ;;

  e2e-remote)
    if [[ ! -x "${REMOTE_E2E_SCRIPT}" ]]; then
      echo "missing executable: ${REMOTE_E2E_SCRIPT}" >&2
      exit 1
    fi
    exec "${REMOTE_E2E_SCRIPT}" "$@"
    ;;

  storage)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      up) run_storage up -d --build "$@" ;;
      down) run_storage down "$@" ;;
      ps) run_storage ps "$@" ;;
      logs) run_storage logs --tail=120 "$@" ;;
      build) run_storage build base-runtime storage-gateway mlflow "$@" ;;
      *)
        echo "unknown storage command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  prefect)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      up) run_prefect up -d "$@" ;;
      down) run_prefect down "$@" ;;
      ps) run_prefect ps "$@" ;;
      logs) run_prefect logs --tail=120 "$@" ;;
      build) docker build -f "${ROOT_DIR}/infra/images/prefect-server.Dockerfile" -t orchestrator-prefect-server:local "$@" "${ROOT_DIR}" ;;
      flush) run_prefect run --rm prefect-maintenance python /opt/orchestrator/scripts/ops/prefect_flush_completed.py --once "$@" ;;
      prune) run_prefect run --rm prefect-maintenance python /opt/orchestrator/scripts/ops/prefect_prune_completed.py --apply "$@" ;;
      *)
        echo "unknown prefect command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  local)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      up) run_local up -d --build "$@" ;;
      down) run_local down "$@" ;;
      ps) run_local ps "$@" ;;
      logs) run_local logs --tail=120 "$@" ;;
      build) run_local build base-runtime storage-gateway worker register "$@" ;;
      *)
        echo "unknown local command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  register)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      run) run_register run --rm register "$@" ;;
      build) run_register build base-runtime register "$@" ;;
      *)
        echo "unknown register command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  worker)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      fixed)
        action="${1:-}"
        shift || true
        case "${action}" in
          up) run_worker_fixed up -d --build "$@" ;;
          down) run_worker_fixed down "$@" ;;
          ps) run_worker_fixed ps "$@" ;;
          logs) run_worker_fixed logs --tail=120 "$@" ;;
          build) run_worker_fixed build base-runtime worker "$@" ;;
          *)
            echo "unknown worker fixed command: ${action}" >&2
            usage
            exit 2
            ;;
        esac
        ;;
      register-gpu)
        run_register run --rm register "$@"
        ;;
      submit)
        if [[ ! -x "${SUBMIT_ROUTER_SCRIPT}" ]]; then
          echo "missing executable: ${SUBMIT_ROUTER_SCRIPT}" >&2
          exit 1
        fi
        exec python3 "${SUBMIT_ROUTER_SCRIPT}" "$@"
        ;;
      *)
        echo "unknown worker command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  *)
    echo "unknown command: ${cmd}" >&2
    usage
    exit 2
    ;;
esac
