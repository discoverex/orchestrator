#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME_ROOT_DEFAULT="$(cd "${ROOT_DIR}/.." && pwd)/runtime"
RUNTIME_ROOT="${RUNTIME_ROOT:-${RUNTIME_ROOT_DEFAULT}}"
source "${ROOT_DIR}/bin/lib/project_lib.sh"

LOCAL_COMPOSE="${ROOT_DIR}/scripts/e2e/docker-compose.local.test.yml"
STORAGE_ENV="${ROOT_DIR}/infra/stacks/storage-node/.env"
STORAGE_COMPOSE="${ROOT_DIR}/infra/stacks/storage-node/docker-compose.yml"
REGISTER_ENV="${ROOT_DIR}/infra/stacks/register/.env"
REGISTER_COMPOSE="${ROOT_DIR}/infra/stacks/register/docker-compose.yml"
WORKER_FIXED_ENV="${ROOT_DIR}/infra/stacks/worker/fixed/.env"
WORKER_FIXED_COMPOSE="${ROOT_DIR}/infra/stacks/worker/fixed/docker-compose.yml"
PREFECT_ENV="${ROOT_DIR}/infra/stacks/prefect-server/.env"
PREFECT_COMPOSE="${ROOT_DIR}/infra/stacks/prefect-server/docker-compose.yml"
E2E_SCRIPT="${ROOT_DIR}/scripts/e2e/e2e_local_orchestrator.sh"
REMOTE_E2E_SCRIPT="${ROOT_DIR}/scripts/e2e/e2e_remote_prefect_storage.sh"
SUBMIT_ROUTER_SCRIPT="${ROOT_DIR}/scripts/ops/prefect_submit_router.py"

usage() {
  cat <<'EOF'
Usage:
  project e2e [core|mlflow] [--keep-on-fail] [--timeout-sec N]
  project e2e-remote --prefect-api-url URL [--work-pool NAME] [--work-queue NAME] [--prune-mode dry-run|apply] [--bootstrap-worker] [--timeout-sec N]
  project base <build> [args...]
  project storage <up|down|ps|logs|build> [args...]
  project prefect <up|down|ps|logs|build|flush|prune> [args...]
  project local <up|down|ps|logs|build> [args...]
  project register <run|build> [args...]
  project runtime init [storage|worker|all]
  project worker fixed <up|down|ps|logs|build> [args...]
  project worker register-gpu [args...]
  project worker submit [router args...]
  project ci

Examples:
  project e2e
  project e2e mlflow --keep-on-fail
  project e2e-remote --prefect-api-url https://prefect.example.com/api --prune-mode apply
  project base build
  project storage up
  project storage down
  project storage logs --tail=120
  project prefect up
  project prefect flush
  project prefect prune
  project local up
  project register run
  project runtime init all
  project worker fixed up
  project worker register-gpu
  project worker submit --job-spec-json '{"engine":"shell","repo_url":"https://github.com/octocat/Hello-World.git","ref":"master","entrypoint":["/bin/sh","-lc","echo hello"]}'
  project ci
EOF
}

cmd="${1:-help}"
shift || true

case "${cmd}" in
  help|-h|--help)
    usage
    ;;

  e2e)
    require_executable "${E2E_SCRIPT}" || exit 1
    mode="${1:-}"
    case "${mode}" in
      core|mlflow)
        shift
        exec "${E2E_SCRIPT}" --mode "${mode}" "$@"
        ;;
      "")
        exec "${E2E_SCRIPT}" --mode core "$@"
        ;;
      *)
        exec "${E2E_SCRIPT}" "$mode" "$@"
        ;;
    esac
    ;;

  e2e-remote)
    require_executable "${REMOTE_E2E_SCRIPT}" || exit 1
    if ! has_prune_mode_arg "$@"; then
      exec "${REMOTE_E2E_SCRIPT}" --prune-mode dry-run "$@"
    fi
    exec "${REMOTE_E2E_SCRIPT}" "$@"
    ;;

  base)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      build) build_base_runtime "$@" ;;
      *)
        echo "unknown base command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  storage)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      up) run_storage up -d --build "$@" ;;
      down) run_storage down "$@" ;;
      ps) run_storage ps "$@" ;;
      logs) run_storage logs --tail=120 "$@" ;;
      build)
        build_base_runtime
        run_storage build base-runtime storage-gateway mlflow "$@"
        ;;
      *)
        echo "unknown storage command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  prefect)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      up) run_prefect up -d "$@" ;;
      down) run_prefect down "$@" ;;
      ps) run_prefect ps "$@" ;;
      logs) run_prefect logs --tail=120 "$@" ;;
      build)
        build_base_runtime
        docker build -f "${ROOT_DIR}/infra/images/prefect-server.Dockerfile" -t orchestrator-prefect-server:local "$@" "${ROOT_DIR}"
        ;;
      flush) run_prefect run --rm prefect-maintenance python /opt/orchestrator/scripts/ops/prefect_flush_completed.py --once "$@" ;;
      prune) run_prefect run --rm prefect-maintenance python /opt/orchestrator/scripts/ops/prefect_prune_completed.py --apply "$@" ;;
      *)
        echo "unknown prefect command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  local)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      up) run_local up -d --build "$@" ;;
      down) run_local down "$@" ;;
      ps) run_local ps "$@" ;;
      logs) run_local logs --tail=120 "$@" ;;
      build)
        build_base_runtime
        run_local build base-runtime storage-gateway worker register "$@"
        ;;
      *)
        echo "unknown local command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  register)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      run) run_register run --rm register "$@" ;;
      build)
        build_base_runtime
        run_register build base-runtime register "$@"
        ;;
      *)
        echo "unknown register command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  runtime)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      init)
        if ! runtime_init_target "${1:-all}"; then
          echo "unknown runtime init target: ${1:-all}" >&2
          usage
          exit 2
        fi
        ;;
      *)
        echo "unknown runtime command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  worker)
    sub="${1:-}"
    shift || true
    case "${sub}" in
      fixed)
        action="${1:-}"
        shift || true
        case "${action}" in
          up) run_worker_fixed up -d --build "$@" ;;
          down) run_worker_fixed down "$@" ;;
          ps) run_worker_fixed ps "$@" ;;
          logs) run_worker_fixed logs --tail=120 "$@" ;;
          build)
            build_base_runtime
            run_worker_fixed build base-runtime worker "$@"
            ;;
          *)
            echo "unknown worker fixed command: ${action}" >&2
            usage
            exit 2
            ;;
        esac
        ;;
      register-gpu)
        run_register run --rm register "$@"
        ;;
      submit)
        require_executable "${SUBMIT_ROUTER_SCRIPT}" || exit 1
        exec python3 "${SUBMIT_ROUTER_SCRIPT}" "$@"
        ;;
      *)
        echo "unknown worker command: ${sub}" >&2
        usage
        exit 2
        ;;
    esac
    ;;

  ci)
    uvx ruff check --fix .
    uvx ruff format .
    uv run mypy
    uv run pytest -q
    ;;

  *)
    echo "unknown command: ${cmd}" >&2
    usage
    exit 2
    ;;
esac
