# Root env used by local scripts, Colab worker bootstrap, and remote helpers.

# Storage-node profile
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000

MINIO_DATA_DIR=/home/esillileu/discoverex/runtime/storage/data/minio
BACKUP_ROOT=/home/esillileu/discoverex/runtime/storage/backup
MLFLOW_DB_DATA_DIR=/home/esillileu/discoverex/runtime/storage/data/mlflow-db

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace_me_minio_access_key
MINIO_SECRET_KEY=replace_me_minio_secret_key
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true
MINIO_PUBLIC_BASE_URL=https://storage-api.discoverex.qzz.io/objects

ARTIFACT_BUCKET=orchestrator-artifacts
PRESIGN_TTL_DEFAULT=900
PRESIGN_TTL_MAX=3600

STORAGE_EXPLORER_ENABLED=true
STORAGE_EXPLORER_LOCAL_ONLY=false

GATEWAY_REQUIRE_CF_ACCESS=false
STORAGE_HUMAN_HOST=storage.discoverex.qzz.io
STORAGE_API_HOST=storage-api.discoverex.qzz.io

CF_ACCESS_CLIENT_ID=replace_me_cf_access_client_id
CF_ACCESS_CLIENT_SECRET=replace_me_cf_access_client_secret

MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=replace_me_mlflow_db_password
PGADMIN_DEFAULT_EMAIL=admin@discoverex.local
PGADMIN_DEFAULT_PASSWORD=replace_me_pgadmin_password
PGADMIN_SCRIPT_NAME=/db
MINIO_BROWSER_REDIRECT_URL=https://storage.discoverex.qzz.io/minio
MLFLOW_STATIC_PREFIX=/mlflow

# Worker-facing routing
STORAGE_API_URL=https://storage-api.discoverex.qzz.io
MLFLOW_TRACKING_URI=https://storage-api.discoverex.qzz.io/mlflow
MLFLOW_PUBLIC_URL=https://storage.discoverex.qzz.io/mlflow

# Prefect worker client defaults
PREFECT_API_URL=https://prefect-api.discoverex.qzz.io/api
PREFECT_WORK_POOL=gpu-pool
PREFECT_WORK_QUEUE=gpu-colab

# Remote helper defaults for Prefect VM operations.
REMOTE_HOST=
REMOTE_USERNAME=
GITHUB_DEPLOY_KEY_PATH=
