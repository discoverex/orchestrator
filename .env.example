MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
PREFECT_API_PORT=14200
STORAGE_GATEWAY_PORT=18100

MINIO_ENDPOINT=127.0.0.1:${MINIO_API_PORT}
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true

ARTIFACT_BUCKET=orchestrator-artifacts
PRESIGN_TTL_DEFAULT=900
PRESIGN_TTL_MAX=3600
STORAGE_GATEWAY_TOKEN=dev-storage-token
