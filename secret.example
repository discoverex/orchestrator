# GitHub Actions secrets/vars template for this repository
# Workflow: .github/workflows/cd.yml

# Required GitHub Secrets
# - None (workflow uses built-in GITHUB_TOKEN)

# Required Repository Variables (Settings > Secrets and variables > Actions > Variables)
# Optional override for image namespace. Default is <owner>/orchestrator.
IMAGE_NAMESPACE=

# Notes
# - Ensure workflow permissions allow package write for GITHUB_TOKEN.
# - If org policy blocks GITHUB_TOKEN package publish, add a PAT and switch login step.
#   GHCR_PAT=
