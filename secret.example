# GitHub Actions CD configuration template
# Target workflow: .github/workflows/cd.yml
#
# Policy:
# - VM does not keep static .env files.
# - Action writes stack-specific .ci.env during deploy and deletes it after `docker compose up`.
# - Set all keys below in GitHub repository Settings > Secrets and variables > Actions.

###############################################
# 1) Required Secrets
###############################################
# SSH
REMOTE_HOST=
REMOTE_USERNAME=
REMOTE_SSH_KEY=

# Storage stack sensitive values
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_URL_SIGNING_SECRET=
STORAGE_GATEWAY_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
MLFLOW_DB_USER=
MLFLOW_DB_PASSWORD=
CF_TUNNEL_ID=
CF_CREDENTIALS_JSON=

# Prefect stack sensitive values
PREFECT_API_DATABASE_CONNECTION_URL=
PREFECT_CF_TUNNEL_ID=
PREFECT_CF_CREDENTIALS_JSON=

###############################################
# 2) Required Variables
###############################################
# Global
IMAGE_NAMESPACE=
REMOTE_PORT=22
REMOTE_PROJECT_PATH=/home/<user>/discoverex/orchestrator
ENABLE_STORAGE_DEPLOY=true
ENABLE_PREFECT_DEPLOY=true

# Storage stack (infra/stacks/storage-node/.ci.env)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_GATEWAY_PORT=8100
MLFLOW_PORT=5000
MINIO_DATA_DIR=/srv/orchestrator/minio
BACKUP_ROOT=/srv/orchestrator/backups
MLFLOW_DB_DATA_DIR=/srv/orchestrator/mlflow-db
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true
ARTIFACT_BUCKET=orchestrator-artifacts
PRESIGN_MODE=gateway
PRESIGN_TTL_DEFAULT=900
PRESIGN_TTL_MAX=3600
STORAGE_EXPLORER_ENABLED=true
STORAGE_EXPLORER_LOCAL_ONLY=false
STORAGE_EXPLORER_LOCAL_HOSTS=127.0.0.1,::1,localhost
STORAGE_EXPLORER_COOKIE_NAME=explorer_session
STORAGE_EXPLORER_SESSION_TTL=28800
STORAGE_EXPLORER_PAGE_SIZE=200
STORAGE_PUBLIC_BASE_URL=https://discoverex.qzz.io
BACKUP_RETENTION_DAYS=30
GATEWAY_REQUIRE_CF_ACCESS=true
MLFLOW_TRACKING_URI=https://mlflow.discoverex.qzz.io
MLFLOW_PUBLIC_URL=https://mlflow.discoverex.qzz.io
MLFLOW_DB_NAME=mlflow
CF_CREDENTIALS_FILE=<storage-tunnel-id>.json

# Prefect stack (infra/stacks/prefect-server/.ci.env)
PREFECT_PORT=4200
PREFECT_BIND_PORT=14200
PREFECT_HOSTNAME=prefect.example.com
PREFECT_API_PUBLIC_URL=https://prefect.example.com/api
PREFECT_CF_CREDENTIALS_FILE=<prefect-tunnel-id>.json
