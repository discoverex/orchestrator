# GitHub Actions CD configuration template (Prefect VM only)
# Workflow: .github/workflows/cd.yml
#
# Policy:
# - VM does not keep static .env files.
# - Action creates infra/stacks/prefect-server/.ci.env during deploy and removes it after compose up.

###############################################
# Required Secrets
###############################################
# SSH access
REMOTE_HOST=
REMOTE_USERNAME=
REMOTE_SSH_KEY=

# Prefect stack sensitive values
PREFECT_DB_PASSWORD=
PREFECT_CF_TUNNEL_ID=
PREFECT_CF_CREDENTIALS_JSON=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
FLUSH_GATEWAY_TOKEN=
FLUSH_CF_ACCESS_CLIENT_ID=
FLUSH_CF_ACCESS_CLIENT_SECRET=

###############################################
# Required Variables
###############################################
# Global
IMAGE_NAMESPACE=
REMOTE_PORT=22
REMOTE_PROJECT_PATH=/home/<user>/discoverex/orchestrator
ENABLE_PREFECT_DEPLOY=true

# Prefect stack (infra/stacks/prefect-server/.ci.env)
PREFECT_PORT=4200
PREFECT_BIND_PORT=14200
PREFECT_HOSTNAME=prefect.example.com
PREFECT_API_PUBLIC_URL=https://prefect.example.com/api
PREFECT_DB_NAME=prefect
PREFECT_DB_USER=prefect_user
PREFECT_DB_DATA_DIR=/srv/orchestrator/prefect-db
PREFECT_CF_CREDENTIALS_FILE=<prefect-tunnel-id>.json
FLUSH_TARGET_URL=https://discoverex.qzz.io
PREFECT_MAINT_DATA_DIR=/srv/orchestrator/prefect-maint
FLUSH_INTERVAL_SEC=600
PRUNE_INTERVAL_SEC=43200
PRUNE_TTL_HOURS=72
FLUSH_PAGE_SIZE=100
FLUSH_MAX_RUNS=500
PRUNE_PAGE_SIZE=200
PRUNE_MAX_RUNS=1000
